# Supabase (Configurações do projeto -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA expor ao client, usada só em Route Handlers (webhook, etc.)
SUPABASE_SERVICE_ROLE_KEY=

# Código de acesso exigido para criar conta admin em /admin/login — só
# você e o(s) organizador(es) de confiança devem saber esse valor. NUNCA
# expor ao client.
ADMIN_SIGNUP_CODE=

# InfinitePay (InfiniteTag, sem o símbolo $)
INFINITEPAY_HANDLE=
# E-mail padrão enviado em customer.email para a InfinitePay em todo
# checkout (o formulário do cardápio não coleta e-mail do cliente)
INFINITEPAY_DEFAULT_CUSTOMER_EMAIL=

# URL pública do site (usada para montar redirect_url/webhook_url da InfinitePay)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Configurações do projeto -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA expor ao client, usada só em Route Handlers (webhook, etc.)
SUPABASE_SERVICE_ROLE_KEY=

# Obsoleto. O cadastro usa códigos de uso único na tabela signup_codes
# (migration 0012). A lista em texto puro fica em signup-codes.local.txt,
# que não entra no git.
ADMIN_SIGNUP_CODE=

# E-mails que abrem o painel geral em /plataforma, separados por vírgula.
# Não é o admin de uma loja: esta conta vê todos os cadastros.
PLATFORM_ADMIN_EMAILS=

# InfinitePay: NÃO é mais configurado aqui — cada tenant tem o próprio
# handle, cadastrado em Configurações no painel admin (tabela tenants).

# URL pública do site (usada para montar redirect_url/webhook_url da InfinitePay)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
